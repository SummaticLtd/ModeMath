<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Compile Include="Units.fs" />
    <Compile Include="MathFontTypes.fs" />
    <Compile Include="MathFontData.g.fs" />
    <Compile Include="MathFont.fs" />
    <Compile Include="MathAtom.fs" />
    <Compile Include="Latex.fs" />
    <Compile Include="Cursor.fs" />
    <Compile Include="Placed.fs" />
    <Compile Include="Layout.fs" />
    <Compile Include="Painter.fs" />
    <Compile Include="Editor.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="Summatic.FSUtils" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ModeMath.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\fonts\modemath-math.otf" LogicalName="ModeMath.modemath-math.otf" />
    <EmbeddedResource
      Include="..\fonts\AMS-Capital-Blackboard-Bold.otf"
      LogicalName="ModeMath.AMS-Capital-Blackboard-Bold.otf" />
    <!-- Both licences require every copy of a face to carry them, so they travel inside the assembly. -->
    <EmbeddedResource
      Include="..\fonts\GUST-FONT-LICENSE.txt"
      LogicalName="ModeMath.GUST-FONT-LICENSE.txt" />
    <EmbeddedResource Include="..\fonts\AMSFONTS-OFL.txt" LogicalName="ModeMath.AMSFONTS-OFL.txt" />
  </ItemGroup>

</Project>
