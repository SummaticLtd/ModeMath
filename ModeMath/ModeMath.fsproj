<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Without this every union and record drags FSharp.Core's structured formatter in. -->
    <OtherFlags>$(OtherFlags) --reflectionfree</OtherFlags>
    <WarnOn>FS3389; FS3395</WarnOn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ModeMath</PackageId>
    <Version>0.7.0</Version>
    <Authors>Summatic Ltd</Authors>
    <Description>Mathematical formula display and editing for .NET, rendered with SkiaSharp. Reads and writes math-mode LaTeX, lays a formula out from the OpenType MATH table, and edits one with a cursor in it.</Description>
    <PackageTags>fsharp;math;latex;typesetting;skiasharp;opentype</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/SummaticLtd/ModeMath</RepositoryUrl>
    <PackageProjectUrl>https://github.com/SummaticLtd/ModeMath</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Pin the floor rather than inheriting the SDK's FSharp.Core, which would force every consumer up to it. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Units.fs" />
    <Compile Include="MathFontTypes.fs" />
    <Compile Include="MathFontData.g.fs" />
    <Compile Include="MathFont.fs" />
    <Compile Include="MathAtom.fs" />
    <Compile Include="Latex.fs" />
    <Compile Include="Cursor.fs" />
    <Compile Include="Placed.fs" />
    <Compile Include="Layout.fs" />
    <Compile Include="Painter.fs" />
    <Compile Include="Editor.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.300" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="Summatic.FSUtils" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ModeMath.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\fonts\modemath-math.otf" LogicalName="ModeMath.modemath-math.otf" />
    <EmbeddedResource
      Include="..\fonts\AMS-Capital-Blackboard-Bold.otf"
      LogicalName="ModeMath.AMS-Capital-Blackboard-Bold.otf" />
    <!-- Both licences require every copy of a face to carry them, so they travel inside the assembly. -->
    <EmbeddedResource
      Include="..\fonts\GUST-FONT-LICENSE.txt"
      LogicalName="ModeMath.GUST-FONT-LICENSE.txt" />
    <EmbeddedResource Include="..\fonts\AMSFONTS-OFL.txt" LogicalName="ModeMath.AMSFONTS-OFL.txt" />
  </ItemGroup>

</Project>
